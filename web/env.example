# Optional. Copy to .env or export in the shell. The server also reads process env.

AWS_REGION=us-east-1
# AWS_PROFILE=elsewhere

# Three layers, cheapest Nova first. Chronicle runs once per finished world.
ELSEWHERE_INTERPRET_MODEL=amazon.nova-micro-v1:0
ELSEWHERE_NARRATE_MODEL=amazon.nova-lite-v1:0
ELSEWHERE_CHRONICLE_MODEL=amazon.nova-lite-v1:0

# Free-play window the prototype is designed to test.
ELSEWHERE_SESSION_MINUTES=30
ELSEWHERE_SESSION_BUDGET_USD=0.20

# Set to mock to force local templates even if AWS is configured.
# ELSEWHERE_AI=mock
